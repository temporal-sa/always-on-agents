# Copy to .env and fill in. The worker and CLI load .env from the current
# directory at startup; variables already set in your shell take precedence.

# Where the model runs: anthropic (default), bedrock, or openai.
# AGENT_MODEL_PROVIDER=anthropic

# Claude credentials (or leave blank and use `ant auth login` instead).
ANTHROPIC_API_KEY=
# AGENT_CLAUDE_MODEL=claude-opus-5-5

# Temporal connection (defaults to a local dev server).
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=

# OpenAI (AGENT_MODEL_PROVIDER=openai). The model must support reasoning effort.
# OPENAI_API_KEY=
# AGENT_OPENAI_MODEL=gpt-6.2-sol

# Claude on Amazon Bedrock (AGENT_MODEL_PROVIDER=bedrock; run `uv sync --extra bedrock`).
# Use a Bedrock API key, or leave it unset to sign with your AWS credentials.
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# AGENT_BEDROCK_MODEL=anthropic.claude-opus-5-5
